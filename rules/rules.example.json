{
  "countPatterns": [
    "^(?P<title>.+?) · (?P<done>\\d+) of (?P<total>\\d+) done$",
    "^\\d+ min · (?P<done>\\d+) of (?P<total>\\d+)$"
  ],
  "rowCountPatterns": [
    "^\\d+ min · (?P<done>\\d+) of (?P<total>\\d+)$",
    "^(?P<done>\\d+) of (?P<total>\\d+) done$"
  ],
  "skipHeadersWithoutRows": true,
  "rowIdentifier": "^coach-(preparation-b\\d+-c\\d+-s\\d+-(left|right)?|move-b\\d+-c\\d+)$",
  "titlePattern": "^(?P<title>.+?) · \\d+ of \\d+ done$",
  "titleIdentifier": "",
  "pinnedBars": ["coach-review-finish", "coach-save-hint", "workout-finish"],
  "minutesThreshold": 60,
  "durationAllow": [],
  "weekPattern": "\\bweek (\\d+)\\b",
  "weekAllow": ["\\bfrom week \\d+\\b"],
  "instructionPatterns": ["\\(skip it", "\\(week \\d+:"],
  "forbiddenText": ["Optional\\(", "\\bnil\\b", "\\bNaN\\b", "\\bundefined\\b"],
  "forbiddenIdentifiers": ["-(left|right)$", "^coach-(timer|rest-timer|move-timer)-start-", "^coach-select-weight-"],
  "fixtures": {"fri": {"forbiddenIdentifiers": ["^coach-preparation-b2-e0-p\\d+-s0-$"]}},
  "maxTapMillis": 1500,
  "maxAppMillis": {"tap": 300, "write": 50},
  "appTimedIdentifiers": ["^coach-preparation-", "^coach-set-done-"]
}
